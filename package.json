{
  "name": "@local/dsh-chat-mode",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "A chat-only agent preset with a minimal prompt, no file access, and an optional switch for billion-context compression tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemuandy/dsh-chat-mode.git"
  },
  "homepage": "https://github.com/hemuandy/dsh-chat-mode#readme",
  "bugs": {
    "url": "https://github.com/hemuandy/dsh-chat-mode/issues"
  },
  "exports": {
    "./no-tools": "./lib/no-tools.js",
    "./settings": "./lib/settings.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "lib/no-tools.js",
    "lib/settings.js",
    "lib/settings-store.js",
    "client.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/schemastery": "3.18.5"
  }
}
